# --- Server ---
PORT=4000
# Public origin of the FRONTEND (Vite dev server proxies /api, /auth, /admin to this backend).
# OAuth redirect URIs are built from this. For Slack OAuth use an https tunnel (e.g. ngrok -> 5173).
APP_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# --- Infra ---
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# --- Google OAuth (redirect URI: {APP_URL}/auth/google/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Slack OAuth (redirect URI: {APP_URL}/auth/slack/callback, scope: incoming-webhook) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Scheduler tuning ---
WORKER_CONCURRENCY=5
# Minimum gap between ANY two sends (BullMQ limiter: 1 job per this many ms)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Hard ceiling per sender per hour (user-supplied hourly limit is clamped to this)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Number of Ethereal sender accounts auto-created on first boot
SENDER_COUNT=3
# Run the BullMQ worker inside the API process (set false and run `npm run worker` separately to scale out)
RUN_WORKER_IN_API=true

# --- Bull Board (/admin/queues) basic auth ---
ADMIN_USER=admin
ADMIN_PASS=admin
